#!/usr/bin/env bash
set -euo pipefail

API="${DBBROKER_API:-http://127.0.0.1:8787}"
command="${1:-}"; shift || true

repo_identity() { printf '%s' "$(git rev-parse --path-format=absolute --git-common-dir)"; }
worktree_identity() { printf '%s' "$(git rev-parse --show-toplevel)"; }
request() { curl --fail-with-body -sS -H 'Content-Type: application/json' "$@"; }
identity_json() {
  local template="${1:-main}"
  printf '{"repository":%s,"worktree":%s,"template":%s}' \
    "$(repo_identity | jq -Rs .)" "$(worktree_identity | jq -Rs .)" "$(printf %s "$template" | jq -Rs .)"
}
assignment_json() {
  local repository="$1" worktree="$2"
  printf '{"repository":%s,"worktree":%s}' \
    "$(printf %s "$repository" | jq -Rs .)" "$(printf %s "$worktree" | jq -Rs .)"
}
# write_env_file PATH KEY=VALUE... replaces each KEY in place, drops duplicates
# and appends missing keys, preserving every other line.
write_env_file() {
  local path="$1" directory temporary line entry matched written=""
  shift
  directory="$(dirname "$path")"
  mkdir -p "$directory"
  temporary="$(mktemp "${path}.tmp.XXXXXX")"
  if [[ -f "$path" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      matched=""
      for entry in "$@"; do
        [[ "$line" == "${entry%%=*}="* ]] && { matched="$entry"; break; }
      done
      if [[ -z "$matched" ]]; then
        printf '%s\n' "$line"
      elif [[ " $written " != *" ${matched%%=*} "* ]]; then
        printf '%s\n' "$matched"
        written+=" ${matched%%=*}"
      fi
    done <"$path" >"$temporary"
  fi
  for entry in "$@"; do
    [[ " $written " == *" ${entry%%=*} "* ]] || printf '%s\n' "$entry" >>"$temporary"
  done
  chmod 600 "$temporary"
  mv "$temporary" "$path"
}
# assignment_env prints the KEY=VALUE pairs an acquire response provides.
assignment_env() {
  jq -er '"DATABASE_URL=\(.database_url // error("missing database_url"))",
    (select(.redis_url) | "REDIS_URL=\(.redis_url)", "REDIS_KEY_PREFIX=\(.redis_key_prefix)")' <<<"$1"
}
reconcile_once() {
  while IFS=$'\t' read -r repository worktree; do
    [[ "$worktree" == /* ]] || continue
    if [[ -d "$worktree" ]]; then
      request -X POST -d "$(assignment_json "$repository" "$worktree")" "$API/v1/heartbeat" >/dev/null
    else
      echo "releasing missing worktree: $worktree" >&2
      request -X POST -d "$(assignment_json "$repository" "$worktree")" "$API/v1/release" >/dev/null
    fi
  done < <(request "$API/v1/assignments" | jq -r '.assignments[] | [.repository, .worktree] | @tsv')
}

case "$command" in
  seed)
    name="${1:?usage: dbbroker seed NAME BACKUP}"; backup="${2:?usage: dbbroker seed NAME BACKUP}"
    curl --fail-with-body -sS -X POST -H "X-DBBroker-Repository: $(repo_identity)" --data-binary "@$backup" "$API/v1/templates/$name" | jq .
    ;;
  acquire)
    shell=false
    env_file=""
    template="main"
    template_set=false
    while (($#)); do
      case "$1" in
        --shell) shell=true ;;
        --env-file)
          shift
          env_file="${1:?--env-file requires a path}"
          ;;
        --env-file=*) env_file="${1#*=}" ;;
        -*) echo "unknown acquire option: $1" >&2; exit 2 ;;
        *)
          $template_set && { echo "only one template may be specified" >&2; exit 2; }
          template="$1"
          template_set=true
          ;;
      esac
      shift
    done
    $shell && [[ -n "$env_file" ]] && { echo "--shell and --env-file are mutually exclusive" >&2; exit 2; }
    response="$(request -X POST -d "$(identity_json "$template")" "$API/v1/acquire")"
    env_lines="$(assignment_env "$response")"
    mapfile -t entries <<<"$env_lines"
    if $shell; then
      for entry in "${entries[@]}"; do printf 'export %s=%q\n' "${entry%%=*}" "${entry#*=}"; done
    elif [[ -n "$env_file" ]]; then
      write_env_file "$env_file" "${entries[@]}"
      keys="$(printf '%s\n' "${entries[@]%%=*}" | paste -sd, - | sed 's/,/, /g')"
      printf 'assigned %s; wrote %s to %s\n' "$(jq -r .database_name <<<"$response")" "$keys" "$env_file"
    else
      jq . <<<"$response"
    fi
    ;;
  heartbeat)
    request -X POST -d "$(identity_json)" "$API/v1/heartbeat" >/dev/null
    ;;
  release)
    request -X POST -d "$(identity_json)" "$API/v1/release" >/dev/null
    ;;
  list)
    request "$API/v1/assignments" | jq .
    ;;
  reconcile)
    reconcile_once
    ;;
  watch)
    interval="${1:-30}"
    [[ "$interval" =~ ^[1-9][0-9]*$ ]] || { echo "interval must be positive seconds" >&2; exit 2; }
    echo "watching worktrees every ${interval}s" >&2
    while true; do reconcile_once || true; sleep "$interval"; done
    ;;
  *) echo "usage: dbbroker {seed NAME FILE|acquire [TEMPLATE] [--shell|--env-file PATH]|heartbeat|release|list|reconcile|watch [SECONDS]}" >&2; exit 2 ;;
esac
